{
  "version": 2,
  
  "headers": [
    {
  "source": "/",
  "headers": [
    {
      "key": "Content-Type",
      "value": "text/html; charset=UTF-8"
    },
    {
      "key": "x-vercel-enable-rewrite-caching",
      "value": "0"
    }
  ]
},
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self)"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
